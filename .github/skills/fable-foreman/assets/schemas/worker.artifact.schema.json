{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Foreman worker artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["files_changed", "verify_commands", "concerns"],
  "properties": {
    "files_changed": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "note"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "note": {"type": "string", "minLength": 1}
        }
      }
    },
    "verify_commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cmd", "result"],
        "properties": {
          "cmd": {"type": "string", "minLength": 1},
          "result": {"type": "string", "minLength": 1}
        }
      }
    },
    "concerns": {"type": "array", "items": {"type": "string"}}
  }
}